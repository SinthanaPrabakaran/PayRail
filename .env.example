# PayRail Environment Variables Template (Phase 2)

# Application Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=PayRail

# Structured Logging
LOG_LEVEL=debug

# MongoDB (Single-Node Replica Set for ACID Multi-Document Transactions)
# Configurable host port (defaults to 27018 to avoid clashing with standalone local MongoDB service)
MONGO_PORT=27018
MONGO_DATABASE=payrail
MONGODB_URI=mongodb://127.0.0.1:27018/payrail?replicaSet=rs0&directConnection=true

# Redis Cache / Distributed Locks (With Password Authentication)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=payrail_redis_pass_dev

# RabbitMQ Message Broker (With Configurable Credentials & Management UI)
RABBITMQ_USER=payrail
RABBITMQ_PASS=payrail_rabbit_pass_dev
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://payrail:payrail_rabbit_pass_dev@127.0.0.1:5672

# Security, Auth & CORS
CORS_ORIGIN=*
JWT_SECRET=payrail_super_secret_jwt_key_dev_mode_32chars
JWT_EXPIRES_IN=15m
JWT_ISSUER=payrail-auth
JWT_AUDIENCE=payrail-api
