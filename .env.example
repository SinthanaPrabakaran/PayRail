# PayRail Environment Variables Template

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=PayRail

# Logging
LOG_LEVEL=debug

# MongoDB
MONGODB_URI=mongodb://localhost:27017/payrail

# Redis Cache / Distributed Locks
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Security & CORS
CORS_ORIGIN=*
